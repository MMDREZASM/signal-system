        "colab_type": "text"
      },
      "source": [
        "<a href=\"https://colab.research.google.com/github/MMDREZASM/signal-system/blob/main/%D9%BE%D8%B1%D9%88%DA%98%D9%87%20%D9%87%D9%81%D8%AA%D9%87%20%D8%AF%D9%88%D9%85.ipymb\" target=\"_parent\"><img src=\"https://colab.research.google.com/assets/colab-badge.svg\" alt=\"Open In Colab\"/></a>"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# --- 1. تابع سیگنال پایه گسسته (x[n]) ---\n",
        "# یک سیگنال نمونه‌ی پله (Unit Step) برای نمایش تبدیل‌های گسسته\n",
        "def x_n_base(n):\n",
        "    \"\"\"x[n] = u[n] - u[n-5] (یک پالس با دامنه 1 از n=0 تا n=4)\"\"\"\n",
        "    return np.where((n >= 0) & (n < 5), 1.0, 0.0)\n",
        "\n",
        "# --- 2. تابع سیگنال پایه پیوسته (x(t)) ---\n",
        "# یک سیگنال نمونه‌ی سینوسی میراشونده (Damped Sinusoid) برای نمایش تبدیل‌های پیوسته\n",
        "def x_t_base(t):\n",
        "    \"\"\"x(t) = exp(-0.5*t) * cos(2*pi*t) * u(t)\"\"\"\n",
        "    return np.exp(-0.5 * t) * np.cos(2 * np.pi * t) * np.where(t >= 0, 1.0, 0.0)\n",
        "\n",
        "# --- 3. تابع کمکی برای اعمال تبدیل گسسته ---\n",
        "def discrete_transform(signal_func, n_new):\n",
        "    \"\"\"\n",
        "    اعمال تبدیل‌های زمانی گسسته بر n_new\n",
        "\n",
        "    پارامترها:\n",
        "    - signal_func: تابع سیگنال اصلی (مثل x_n_base)\n",
        "    - n_new: آرایه‌ی numpy شامل مقادیر جدید n برای سیگنال تبدیل شده\n",
        "\n",
        "    خروجی:\n",
        "    - مقدار سیگنال در هر یک از مقادیر جدید n\n",
        "    \"\"\"\n",
        "    # در سیگنال‌های گسسته، آرگومان سیگنال باید مقادیر صحیح داشته باشد\n",
        "    # بنابراین، مقادیر n_new را گرد می‌کنیم\n",
        "    n_new_int = np.round(n_new).astype(int)\n",
        "    return signal_func(n_new_int)\n",
        "\n",
        "# تعریف دامنه‌ی زمان برای سیگنال‌های گسسته\n",
        "n_min, n_max = -5, 10\n",
        "n = np.arange(n_min, n_max + 1) # مقادیر اصلی n\n",
        "x_n = x_n_base(n)              # سیگنال اصلی گسسته\n",
        "\n",
        "# تعریف دامنه‌ی زمان برای سیگنال‌های پیوسته\n",
        "t_min, t_max = -1, 7\n",
        "t = np.linspace(t_min, t_max, 500) # مقادیر اصلی t (نمونه‌گیری شده)\n",
        "x_t = x_t_base(t)                # سیگنال اصلی پیوسته\n",
        "\n",
        "# رسم سیگنال‌های پایه برای ارجاع (اختیاری)\n",
        "# plt.figure(figsize=(10, 3))\n",
        "# plt.subplot(1, 2, 1)\n",
        "# plt.stem(n, x_n, use_line_collection=True)\n",
        "# plt.title('$x[n]$ Base Signal')\n",
        "# plt.subplot(1, 2, 2)\n",
        "# plt.plot(t, x_t)\n",
        "# plt.title('$x(t)$ Base Signal')\n",
        "# plt.tight_layout()\n",
        "# plt.show()"
      ],
      "metadata": {
        "id": "ci2_wq6cwSWj"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "### تبدیل‌های گسسته (Discrete Time) ###\n",
        "\n",
        "# 1. x[n-2]: تأخیر (Delay)\n",
        "n1_new = n - 2\n",
        "y1 = discrete_transform(x_n_base, n1_new)\n",
        "\n",
        "# 2. x[3/2 n + 3]: مقیاس‌بندی و تقدم (Advance)\n",
        "n2_new = (3/2) * n + 3\n",
        "y2 = discrete_transform(x_n_base, n2_new)\n",
        "\n",
        "# 3. x[n] + x[2n] - 3: ترکیب (Scaling, Time Scaling, Amplitude Shift)\n",
        "# برای x[2n]\n",
        "n3_b_new = 2 * n\n",
        "x_2n = discrete_transform(x_n_base, n3_b_new)\n",
        "# محاسبه y3\n",
        "y3 = x_n + x_2n - 3"
      ],
      "metadata": {
        "id": "TvcgZYdCwjuA"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "### تبدیل‌های پیوسته (Continuous Time) ###\n",
        "\n",
        "# ع. x(3t - 1/2): فشردگی و تأخیر\n",
        "t_new_c = 3 * t - 1/2\n",
        "y_c = x_t_base(t_new_c)\n",
        "\n",
        "# د. x(1/2 t + 3): انبساط و تقدم\n",
        "t_new_d = (1/2) * t + 3\n",
        "y_d = x_t_base(t_new_d)\n",
        "\n",
        "# ه. x(t-2) - t: تأخیر و تغییر دامنه\n",
        "t_new_e = t - 2\n",
        "x_t_minus_2 = x_t_base(t_new_e)\n",
        "y_e = x_t_minus_2 - t"
      ],
      "metadata": {
        "id": "uO8dTShGwuqC"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "# رسم سیگنال‌های گسسته\n",
        "plt.figure(figsize=(12, 8))\n",
        "\n",
        "plt.subplot(3, 1, 1)\n",
        "plt.stem(n, y1, label='$x[n-2]$', use_line_collection=True)\n",
        "plt.title('1. $x[n-2]$ (Delay)')\n",
        "plt.grid(True)\n",
        "\n",
        "plt.subplot(3, 1, 2)\n",
        "plt.stem(n, y2, label='$x[\\\\frac{3}{2}n+3]$', use_line_collection=True)\n",
        "plt.title('2. $x[\\\\frac{3}{2}n+3]$ (Scaling & Advance)')\n",
        "plt.grid(True)\n",
        "\n",
        "plt.subplot(3, 1, 3)\n",
        "plt.stem(n, y3, label='$x[n]+x[2n]-3$', use_line_collection=True)\n",
        "plt.title('3. $x[n]+x[2n]-3$ (Combined)')\n",
        "plt.xlabel('n (Discrete Time)')\n",
        "plt.grid(True)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# ---\n",
        "\n",
        "# رسم سیگنال‌های پیوسته\n",
        "plt.figure(figsize=(12, 8))\n",
        "\n",
        "plt.subplot(3, 1, 1)\n",
        "plt.plot(t, y_c, label='$x(3t - \\\\frac{1}{2})$')\n",
        "plt.title('ع. $x(3t - \\\\frac{1}{2})$ (Compression & Delay)')\n",
        "plt.grid(True)\n",
        "\n",
        "plt.subplot(3, 1, 2)\n",
        "plt.plot(t, y_d, label='$x(\\\\frac{1}{2}t + 3)$')\n",
        "plt.title('د. $x(\\\\frac{1}{2}t + 3)$ (Expansion & Advance)')\n",
        "plt.grid(True)\n",
        "\n",
        "plt.subplot(3, 1, 3)\n",
        "plt.plot(t, y_e, label='$x(t-2)-t$')\n",
        "plt.title('ه. $x(t-2)-t$ (Delay & Non-linear Amplitude Shift)')\n",
        "plt.xlabel('t (Continuous Time)')\n",
        "plt.grid(True)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "metadata": {
        "id": "HOfcy2-Qw10x"
      },
      "execution_count": null,
      "outputs": []
    }
